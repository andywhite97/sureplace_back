# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Database / PostGIS
DATABASE_URL=postgis://sureplace:sureplace@localhost:5432/sureplace
USE_SQLITE=false
GDAL_LIBRARY_PATH=C:/Program Files/PostgreSQL/18/bin/libgdal-35.dll
GEOS_LIBRARY_PATH=C:/Program Files/PostgreSQL/18/bin/libgeos_c.dll
# Frontend / CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=
FRONTEND_BASE_URL=http://localhost:4200
PUBLIC_CONFIG_CACHE_SECONDS=900
PUBLIC_REFERENCE_CACHE_SECONDS=3600
FEATURED_LISTINGS_CACHE_SECONDS=60
# Cloudinary
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email
EMAIL_PROVIDER=django
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SurePlace <noreply@sureplace.co.sz>
DEFAULT_FROM_NAME=SurePlace
DEFAULT_REPLY_TO_EMAIL=
EMAIL_LOGO_URL=
EMAIL_VERIFICATION_TTL_SECONDS=86400
AGENCY_INVITATION_TTL_DAYS=7
BIRD_API_KEY=
BIRD_API_BASE_URL=
BIRD_REQUEST_TIMEOUT_SECONDS=10
BIRD_TRACK_OPENS=false
BIRD_TRACK_CLICKS=false
# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
SAVED_SEARCH_INTERVAL_SECONDS=900
# Booking / reminders
BOOKING_HOLD_MINUTES=30
MESSAGE_EMAIL_COOLDOWN_MINUTES=30
PROPERTY_AVAILABILITY_REMINDER_DAYS=7
PROPERTY_AVAILABILITY_STALE_DAYS=30
# Feature flags
PROPERTIES_ENABLED=true
STAYS_ENABLED=true
BOOKINGS_ENABLED=true
INTERNAL_MESSAGING_ENABLED=true
REGISTRATION_ENABLED=true
# Upload limits
VERIFICATION_MAX_FILE_MB=10
# Throttling
THROTTLE_AUTH_REGISTER=10/hour
THROTTLE_AUTH_LOGIN=20/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_EMAIL_VERIFICATION=5/minute
THROTTLE_AGENCY_MANAGEMENT=60/hour
THROTTLE_AGENCY_INVITATION=20/hour
THROTTLE_GUEST_ENQUIRY=10/hour
THROTTLE_INTERNAL_MESSAGE=120/hour
THROTTLE_VIEWING_REQUEST=20/hour
THROTTLE_BOOKING_CREATE=20/hour
THROTTLE_VERIFICATION_UPLOAD=30/hour
THROTTLE_LISTING_REPORT=20/hour
# Logging / Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# Reference defaults
DEFAULT_COUNTRY=SZ
DEFAULT_CURRENCY=SZL
MAP_DEFAULT_LATITUDE=-26.5225
MAP_DEFAULT_LONGITUDE=31.4659
MAP_DEFAULT_ZOOM=8
